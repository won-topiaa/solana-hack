{
  "name": "rwa-liquidity-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "params:check": "tsx scripts/check-params.ts",
    "params:refresh": "tsx --env-file-if-exists=.env.local scripts/refresh-params.ts",
    "agent:chat": "tsx --env-file-if-exists=.env.local scripts/agent-chat.ts",
    "chain:wallets": "tsx --env-file-if-exists=.env.local scripts/chain-wallets.ts",
    "chain:demo": "tsx --env-file-if-exists=.env.local scripts/chain-demo.ts",
    "chain:hei": "tsx --env-file-if-exists=.env.local scripts/chain-hei.ts"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token-2022": "^0.19.0",
    "@solana/kit": "^8.4.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
