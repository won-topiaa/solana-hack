# Copy this file to .env.local and fill in values there. Never commit real keys.
# Each variable is filled in when its milestone needs it; names may change then.

# M2: FRED API key for `npm run params:refresh` (SOFR and mortgage rates).
# Request one after logging in at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# M3: Gemini API key (https://ai.google.dev/gemini-api/docs/api-key). Optional model override.
# Use a paid-tier key for real user data (on the unpaid tier Google may review prompts).
GEMINI_API_KEY=
GEMINI_MODEL=

# M4: RentCast property data (https://www.rentcast.io/api). Without a key, made-up demo homes are used.
RENTCAST_API_KEY=
# Set to "demo" to use the made-up demo homes even when a key is set (for demo recordings).
PROPERTY_DATA_SOURCE=

# M4: Plaid Liabilities, sandbox only (https://plaid.com/products/liabilities/).
# Both values come from the Plaid Dashboard's Keys page; use the Sandbox secret.
PLAID_CLIENT_ID=
PLAID_SECRET=

# M7: optional Solana devnet RPC URL (default: https://api.devnet.solana.com).
# Devnet wallets live in the git-ignored .wallets/devnet (npm run chain:wallets).
SOLANA_RPC_URL=

# M9: seals the web app's case tokens. Any random string of 32+ characters,
# e.g. `openssl rand -base64 48`. Changing it invalidates open cases.
CASE_SECRET=

# M10: deployment for the judging period. Freezes the registry values on this date
# (YYYY-MM-DD): freshness is checked on it and the page says the values are as of it.
# Leave empty locally, so stale values still stop a recommendation.
REGISTRY_FROZEN_ON=

# M10: on a server without .wallets/devnet (Vercel), each devnet wallet comes from an
# environment variable holding the same 64-number JSON array as its file, and the
# test dollar's mint address from DEVNET_TEST_DOLLAR_MINT. Devnet only; still secret.
DEVNET_WALLET_ISSUER=
DEVNET_WALLET_USER=
DEVNET_WALLET_INVESTOR_KYC=
DEVNET_WALLET_INVESTOR_KYC_2=
DEVNET_WALLET_INVESTOR_NO_KYC=
DEVNET_TEST_DOLLAR_MINT=
