# Copy this file to .env.local and fill in values there. Never commit real keys.
# Only GEMINI_API_KEY and CASE_SECRET are required; the rest turn features on.

# FRED API key for `npm run params:refresh` (SOFR, mortgage rates and the FHFA house price index).
# Request one after logging in at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Gemini API key (https://ai.google.dev/gemini-api/docs/api-key). Optional model override.
# Use a paid-tier key for real user data (on the unpaid tier Google may review prompts).
GEMINI_API_KEY=
GEMINI_MODEL=

# RentCast property data (https://www.rentcast.io/api). Without a key, made-up demo homes are used.
RENTCAST_API_KEY=
# Set to "demo" to use the made-up demo homes even when a key is set (for demo recordings).
PROPERTY_DATA_SOURCE=

# Plaid Liabilities, sandbox only (https://plaid.com/products/liabilities/).
# Both values come from the Plaid Dashboard's Keys page; use the Sandbox secret.
PLAID_CLIENT_ID=
PLAID_SECRET=
# Investor KYC in Plaid's sandbox (Identity Verification). Dashboard: Products -> Identity Verification
# "Enable Sandbox", then a template with only the data source (KYC) check and no SMS step; copy its
# template_id (idvtmp_...). Without it the identity check is simulated and labeled so; the KYC
# attestation on Solana is written and checked either way.
PLAID_IDV_TEMPLATE_ID=

# optional Solana devnet RPC URL (default: https://api.devnet.solana.com).
# Devnet wallets live in the git-ignored .wallets/devnet (npm run chain:wallets).
SOLANA_RPC_URL=

# seals the web app's case tokens. Any random string of 32+ characters,
# e.g. `openssl rand -base64 48`. Changing it invalidates open cases.
CASE_SECRET=

# Freezes the registry values on this date (YYYY-MM-DD): freshness is checked on it and
# the page says the values are as of it. The deployment for the judging period sets it.
# Market values expire after a few days, so to run locally with the values as of the
# submission, set it to the registry's date; leave it empty to keep the freshness gate strict.
REGISTRY_FROZEN_ON=

# on a server without .wallets/devnet (Vercel), each devnet wallet comes from an
# environment variable holding the same 64-number JSON array as its file, and the
# test dollar's mint address from DEVNET_TEST_DOLLAR_MINT. Devnet only; still secret.
DEVNET_WALLET_ISSUER=
DEVNET_WALLET_USER=
DEVNET_WALLET_INVESTOR_KYC=
DEVNET_WALLET_INVESTOR_KYC_2=
DEVNET_WALLET_INVESTOR_NO_KYC=
DEVNET_TEST_DOLLAR_MINT=
